# Copy to .env and adjust. `npm start` and `npm run build` turn these values into
# public/runtime-config.js, which the browser loads before the app starts.
# Values set in the environment win over the ones in .env.

# Skill-Wanderer SSO (Keycloak): the admin realm and the public client (PKCE) this admin signs in with.
KEYCLOAK_URL=https://sso.skill-wanderer.com
KEYCLOAK_REALM=skill-wanderer-admin
KEYCLOAK_CLIENT_ID=skill-wanderer-admin

# Comma-separated roles that may open the admin. A plain name is a realm role;
# "client:role" is a role on that client. Default: CRM
ADMIN_ROLES=CRM

# Backend API. Only requests to this URL get the access token, and the dashboard checks it
# with GET /api/v1/me. Leave empty to run the admin without an API.
API_BASE_URL=
